# Port the app listens on inside the container
PORT=4040

# Where tasks, check-offs and the to-do list live (e.g. /mnt/user/appdata/walltab)
DATA_DIR=./data

# User/group the container runs as, so you can edit the data files without sudo.
# Run `id` to find yours. On Unraid use PUID=99 and PGID=100 (nobody:users).
PUID=1000
PGID=1000

# Weather location (Open-Meteo, no API key needed). First match wins:
#   1. LAT + LON            exact coordinates (CITY_NAME, if set, is just the display name)
#   2. CITY_NAME alone      a town name, looked up automatically, e.g. CITY_NAME=Springfield, IL
#   3. browser location     shared by any browser on a secure page (HTTPS or localhost)
#   4. server's public IP   city-level guess; may land on your ISP's hub instead
LAT=
LON=
CITY_NAME=

# fahrenheit or celsius
TEMP_UNIT=fahrenheit

# CalDAV server (e.g. Radicale). Each calendar is fetched from CALDAV_URL/CALDAV_USERNAME/<name>/;
# leave a calendar blank to skip it.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CLASSES=
WORK=
PERSONAL=
CANVAS=

# Timezone for calendar times and day boundaries (e.g. America/New_York)
TZ=

# How late a day runs before the dashboard rolls over to "tomorrow" (0-23, hour in TZ above).
# Blank/0 = midnight. Set this if you're regularly up past midnight and don't want
# tomorrow's tasks/reset to show until you're actually done for the night, e.g. 4 for 4am.
DAY_ROLLOVER_HOUR=

# Seconds for the clock digits to roll (like a dial) when they change, instead of jumping
# instantly (e.g. 1.5). Blank/0 = no fade.
CLOCK_FADE_SECONDS=

# What counts toward the day's completion ring (true/false).
#   COUNT_EVENTS: timed calendar events (classes, work, ...) count as done once they've ended.
#   COUNT_TODOS:  the to-do list counts. Set false if you queue up to-dos the night before
#                 for tomorrow; they still show and can be checked off, just not counted.
COUNT_EVENTS=false
COUNT_TODOS=true

# Calendars shown in the "This week" view (any of: classes, work, personal, canvas).
# canvas = assignments only; Canvas course meetings count as classes. Blank = all.
WEEK_CALENDARS=work,canvas,personal
